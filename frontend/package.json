{
  "name": "mindvault-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first Electron desktop client for MindVault",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js",
    "check": "node --check main.js && node --check backendManager.js && node --check preload.js && node --check renderer/js/d3-lite.js && node --check renderer/js/dashboard.js && node --check renderer/js/workspace.js && node --check renderer/js/app.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^31.0.0"
  },
  "build": {
    "appId": "com.mindvault.desktop",
    "productName": "MindVault",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backendManager.js",
      "renderer/**/*",
      "package.json",
      "!**/*.gguf",
      "!**/*.bin",
      "!**/*.onnx",
      "!**/*.safetensors",
      "!models/**",
      "!data/**"
    ],
    "extraResources": [
      {
        "from": "../backend/app",
        "to": "backend/app",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../run.py",
        "to": "run.py"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
